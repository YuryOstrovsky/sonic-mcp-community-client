# SONiC MCP Community Client — backend configuration
# Copy to .env and edit values for your setup.

# ------------------------------------------------------------------
# Upstream MCP server
# ------------------------------------------------------------------

# Where the SONiC MCP Community Server is listening.
MCP_BASE_URL=http://127.0.0.1:8000

# HTTP timeout for outbound calls to the MCP server (seconds).
MCP_TIMEOUT_SECONDS=30

# Upstream API key — MUST match the server's MCP_API_KEY when the server has
# authentication enabled (the recommended secure config). The backend forwards
# it as `Authorization: Bearer <key>` on every upstream call. Backend-only —
# it is never sent to the browser. Leave blank if the server has no auth.
MCP_API_KEY=

# ------------------------------------------------------------------
# Client-facing authentication  (browser/user -> this proxy)
# ------------------------------------------------------------------
# A DIFFERENT secret from MCP_API_KEY. When set, sensitive /api routes
# (invoke, nl, inventory writes, probe, settings, intent) require
# `Authorization: Bearer <CLIENT_API_KEY>`. When unset, the proxy has NO
# client-facing auth and logs a warning — rely on a localhost bind and/or an
# authenticated reverse proxy (SSO / OAuth2-proxy / Authelia / basic auth).
# Generate with:  openssl rand -hex 32
CLIENT_API_KEY=

# Comma-separated CORS origins. Empty = no cross-origin access (correct for
# single-port production where the UI and API share an origin). For Vite dev:
#   CLIENT_CORS_ORIGINS=http://localhost:5173
CLIENT_CORS_ORIGINS=

# ------------------------------------------------------------------
# Persisted settings
# ------------------------------------------------------------------
# Where UI-chosen settings (LLM provider, optional API keys) are stored.
# Default is inside the mounted data volume so it survives container restarts.
CLIENT_SETTINGS_PATH=/app/backend/data/settings.json

# ------------------------------------------------------------------
# Optional: LLM fallback for /api/nl unmatched queries
# ------------------------------------------------------------------
# When OpenAI is selected, the query, tool descriptions, and (unless disabled
# below) limited device context are sent to OpenAI — data leaves the local
# environment. Use Ollama or disable LLM fallback for fully local operation.
# Do NOT put credentials or confidential production data in NL prompts.

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_ENABLED=0
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b-instruct

# Include device IPs/reachability in the external LLM prompt (1=yes, 0=no).
# Default 0 keeps management IPs out of OpenAI/Ollama context. Set 1 to opt in
# for better tool selection (lets the LLM resolve switch_ip from device context).
LLM_INCLUDE_DEVICE_CONTEXT=0

# ------------------------------------------------------------------
# Local tunables
# ------------------------------------------------------------------

# Backend listen port (used by uvicorn launcher when running via python -m)
CLIENT_BACKEND_PORT=5174
